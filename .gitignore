# deps
node_modules/

# env — nothing here needs one; the glob keeps a stray key file out of git
.env*

# task zip output
dist/

# system
.DS_Store
*.log
*.tsbuildinfo
__pycache__/

# skill eval runs (agentskills.io "Evaluating skills"): results, never sources
*-workspace/

# claude code (skills installed per project by `npx skills add`, not this repo's content)
.claude/skills/
# claude code (per-machine permission grants — never commit)
.claude/settings.local.json
# claude code (handoff note the SessionEnd hook leaves per branch — machine-local)
.claude/handoff/
# claude code (worktrees created by EnterWorktree; Superpowers' .worktrees/ too)
.claude/worktrees/
.worktrees/

# /claude-security reports (ADR-0004 of the claude-code-setup repo)
CLAUDE-SECURITY-*/
